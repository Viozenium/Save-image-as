{
  "manifest_version": 3,
  "name": "Save Image As",
  "version": "1.1.0",
  "description": "Save images as JPG, PNG or WebP via context menu.",
  "icons": {
    "128": "assets/icons/icon.png"
  },
  "permissions": ["contextMenus", "downloads", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html"
}
